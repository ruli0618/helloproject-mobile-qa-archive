    "content_title": "北海道公演",
    "content_sub_title": "窪田七海",
    "category_id": "182",
    "release_date": "2025-02-27 19:01:00",
    "created_at": "2025-02-27 19:22:32",
    "updated_at": "2025-02-27 19:22:32",
